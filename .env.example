# the AbuseIPDB key (https://www.abuseipdb.com/account/api) goes in secrets/api_token, not here:
# docker inspect shows everything in this file. empty file = no AbuseIPDB reporting

# host port the tarpit is published on. 22 needs your real sshd moved first; use 2222 to try it out
HOST_PORT=22

# 1 = log connections but send nothing anywhere
DRY_RUN=0

# never report these (comma separated ips or cidr ranges, e.g. your own)
ALLOWLIST=

# optional: also POST every fresh visitor as json to this https url
# WEBHOOK_URL=
# WEBHOOK_AUTH=Bearer replace-me
