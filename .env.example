# AbuseIPDB API key: https://www.abuseipdb.com/account/api (required unless DRY_RUN=1)
API_TOKEN=

# host port the tarpit is published on. 22 needs your real sshd moved first; use 2222 to try it out
HOST_PORT=22

# 1 = log connections but send nothing to AbuseIPDB
DRY_RUN=0

# never report these (comma separated plain ips, e.g. your own)
ALLOWLIST=
