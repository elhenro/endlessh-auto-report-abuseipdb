# AbuseIPDB API key: https://www.abuseipdb.com/account/api. empty = no AbuseIPDB reporting.
# docker inspect shows everything in this file. to keep it out of there, put the key in
# secrets/api_token instead and add docker-compose.secrets.yml to COMPOSE_FILE below
API_TOKEN=

# docker-compose.ipv6.yml gets ipv6 clients limited and reported. leave it out if the kernel has ipv6 off
COMPOSE_FILE=docker-compose.yml:docker-compose.ipv6.yml

# host port the tarpit is published on. 22 needs your real sshd moved first; use 2222 to try it out
HOST_PORT=22

# 1 = log connections but send nothing anywhere. keep it on for any port other than 22
DRY_RUN=0

# never report these (comma separated ips or cidr ranges, e.g. your own)
ALLOWLIST=

# optional: also POST every fresh visitor as json to this https url
# WEBHOOK_URL=
# WEBHOOK_AUTH=Bearer replace-me
