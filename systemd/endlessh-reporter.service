[Unit]
Description=SSH tarpit (endlessh) with AbuseIPDB reporting
Documentation=https://github.com/elhenro/endlessh-auto-report-abuseipdb
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/endlessh-reporter/tarpitReporter.sh
EnvironmentFile=/etc/endlessh-reporter/env
Environment=REPORTED_FILE=/var/lib/endlessh-reporter/reportedIps.txt
Environment=EVENTS_DIR=/var/lib/endlessh-reporter/events
# token is handed over as a credential file, never an env var or argv
LoadCredential=api_token:/etc/endlessh-reporter/api_token
StateDirectory=endlessh-reporter
# one fd per stuck client; systemd's soft default of 1024 is below TARPIT_MAX_CLIENTS
LimitNOFILE=8192
Restart=on-failure
RestartSec=5
# config errors (bad token, bad settings) exit 78: do not loop on them
RestartPreventExitStatus=78
# the reporter exits 143 on SIGTERM; that is a clean stop, not a failure
SuccessExitStatus=143

# unprivileged throwaway user that may still bind port 22
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
